{
  "name": "nb-plus",
  "version": "1.0.0",
  "description": "NB-PLUS tunnel and proxy",
  "main": "src/index.js",
  "bin": "src/index.js",
  "scripts": {
    "start": "npm run build:webui && node src/index.js",
    "build:css": "npx tailwindcss -i ./src/web/public/input.css -o ./src/web/public/tailwind.css --minify",
    "build:webui": "cd webui && npm run build",
    "build:app": "node -e \"require('fs').copyFileSync('prebuilds/better_sqlite3.node.linux.x64.v24.18.0','node_modules/better-sqlite3/build/Release/better_sqlite3.node.linux.x64.v24.18.0')\" & npx @yao-pkg/pkg . --out-path dist --compress Zstd",
    "build": "npm run build:webui && npm run build:app",
    "dev:webui": "cd webui && npm run dev",
    "dev:backend": "node src/index.js"
  },
  "pkg": {
    "scripts": "src/**/*.js",
    "assets": [
      "src/web/public/**/*",
      "bin/xray.exe",
      "bin/xray",
      "bin/geoip.dat",
      "bin/geosite.dat",
      "bin/wintun.dll",
      "node_modules/better-sqlite3/build/Release/better_sqlite3.node",
      "node_modules/better-sqlite3/lib/**/*",
      "node_modules/better-sqlite3/package.json"
    ],
    "targets": [
      "node24-win-x64",
      "node24-linux-x64"
    ]
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-basic-auth": "^1.2.1",
    "geoip-lite": "^1.4.10",
    "ipaddr.js": "^2.1.0",
    "node-forge": "^1.4.0",
    "winston": "^3.10.0",
    "winston-daily-rotate-file": "^4.7.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.21.0",
    "pkg": "^5.8.1",
    "tailwindcss": "^4.3.1",
    "vue": "^3.5.38"
  }
}
